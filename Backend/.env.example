MYSQL_ROOT_PASSWORD=replace-with-a-strong-local-password
MYSQL_DATABASE=iot_project
MYSQL_USER=iot_app
MYSQL_PASSWORD=replace-with-another-strong-local-password
IOT_DB_URL=jdbc:mysql://127.0.0.1:3307/iot_project?connectionTimeZone=UTC&sslMode=DISABLED&allowPublicKeyRetrieval=true
IOT_DB_USER=iot_app
IOT_DB_PASSWORD=replace-with-the-same-value-as-MYSQL_PASSWORD
IOT_SEED_USERNAME=your-username
IOT_SEED_PASSWORD=replace-with-a-seed-account-password
IOT_SEED_FULL_NAME=Your Name
IOT_SEED_STUDENT_CODE=Your Student Code
IOT_SEED_EMAIL=you@example.com
IOT_JWT_SECRET_BASE64=replace-with-Base64-of-at-least-32-random-bytes
IOT_JWT_TTL_SECONDS=3600
IOT_MQTT_URI=tcp://127.0.0.1:1883
IOT_MQTT_CLIENT_ID=iot-backend-telemetry
IOT_MQTT_USER=your-local-broker-user
IOT_MQTT_PASSWORD=replace-with-a-local-broker-password
IOT_FRONTEND_ORIGIN=http://localhost:5173
